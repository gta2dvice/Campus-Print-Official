# Root copy of backend variable names for `npm` scripts run from this directory.
# Real values belong in server/.env (preferred) or this file. Never commit real secrets.

# Server
PORT=3000
NODE_ENV=development
SESSION_SECRET=generate-a-long-random-string
# Set to the exact production Vercel origin on Render.
FRONTEND_URL=http://localhost:3000
# Optional comma-separated additional exact origins; localhost:3000 and :5173 are always allowed.
CORS_ORIGINS=
PUBLIC_API_URL=http://localhost:3000

# Supabase Postgres (Dashboard → Project Settings → Database → URI)
DATABASE_URL=your-supabase-postgres-connection-string

# Supabase API + Storage (server only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-secret
SUPABASE_STORAGE_BUCKET=uploaded-pdfs

# Cron / Edge Function
CRON_SECRET=generate-a-long-random-string

# Cloudflare Turnstile (Server & Frontend)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional `npm run init-db` seeds
ADMIN_EMAIL=
ADMIN_PASSWORD=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Optional `npm run migrate-mysql`
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=campusprint

# Cashfree Payments (server only)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
CASHFREE_DEFAULT_PHONE=9999999999
# Optional dedicated secret for deriving guest ticket access tokens.
TICKET_TOKEN_SECRET=
