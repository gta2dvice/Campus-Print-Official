# Frontend Environment Variables

# Leave empty with the Vercel /api rewrite. Most app calls are relative and do not use this helper.
VITE_API_URL=

# Supabase Auth Configuration
# Obtainable from Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://npxfzhzzrdmuscrzajrz.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Cloudflare Turnstile Bot Protection
# Obtainable from Cloudflare Dashboard -> Turnstile -> Sites
VITE_TURNSTILE_SITE_KEY=your-cloudflare-turnstile-site-key-here
